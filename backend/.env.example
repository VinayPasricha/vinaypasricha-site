# ============================================================
#  Backend secrets — COPY this file to ".env" and fill in.
#  The real ".env" is gitignored and must NEVER be committed.
# ============================================================

# --- MongoDB ---
# The connection string from MongoDB Atlas (Database > Connect > Drivers).
# Looks like: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/vinay?retryWrites=true&w=majority
MONGODB_URI=

# Name of the database to use inside the cluster (optional if already in the URI).
MONGODB_DB=vinay

# --- Google Sign-In ---
# The OAuth "Client ID" from Google Cloud Console (APIs & Services > Credentials).
# Looks like: 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- Server ---
# Port the backend listens on locally.
PORT=4000

# Comma-separated browser origins allowed to call this API cross-origin.
# Unset, the server allows only https://vinaypasricha.com. These localhost
# entries override that default for local development.
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:8000,http://127.0.0.1:8000

# How long a conversation is kept before MongoDB auto-deletes it.
CONVERSATION_TTL_DAYS=30

# Optional Firestore collection prefix for isolated non-production data.
# Leave empty in production. Use "staging_" on the staging Cloud Run service.
FIRESTORE_COLLECTION_PREFIX=

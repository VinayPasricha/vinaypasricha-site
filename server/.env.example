# Copy to .env and fill from ACCOUNTS.md. All three utilities are free to start.

# --- Utility 1: Postgres (Neon / Supabase) ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Utility 2: Object storage (Cloudflare R2 / Backblaze B2, S3-compatible) ---
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=runtime-essence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Utility 3: Sign in with Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Master key (envelope encryption). In production this lives in a managed KMS. ---
# For local/dev, a base64 32-byte key. `npm run gen-master-key` generates it AND the
# three Shamir keeper-pieces (2-of-3) you distribute to the three keepers in ACCOUNTS.md.
MASTER_KEY_BASE64=

# Server
PORT=3000
# 30-day Holding Buffer window (days). Do not raise without a retention-policy decision.
RAW_RETENTION_DAYS=30
# Inactivity finalization window (minutes)
INACTIVITY_MINUTES=30
